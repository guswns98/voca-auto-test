# Appium 서버
APPIUM_HOST=http://127.0.0.1:4723

# 플랫폼: android 또는 ios
PLATFORM=android

# Android
APP_PACKAGE=com.knockknock.voca
APP_ACTIVITY=.MainActivity

# iOS
BUNDLE_ID=com.knockknock.voca

# 테스트 계정
TEST_EMAIL=test@example.com
TEST_PASSWORD=testpassword

# 타임아웃 (초)
IMPLICIT_WAIT=10
EXPLICIT_WAIT=15

# 앱 초기화 여부
NO_RESET=false
